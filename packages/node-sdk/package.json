{
  "name": "@moonshot-ai/kimi-code-sdk",
  "version": "0.21.0",
  "private": true,
  "description": "In-process agent SDK for the WoW desktop app",
  "license": "MIT",
  "author": "WoW",
  "homepage": "https://github.com/qhy99997/WoW-Agent/tree/main/packages/node-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qhy99997/WoW-Agent.git",
    "directory": "packages/node-sdk"
  },
  "bugs": {
    "url": "https://github.com/qhy99997/WoW-Agent/issues"
  },
  "keywords": [
    "kimi",
    "sdk",
    "typescript",
    "agent",
    "api"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      }
    },
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@moonshot-ai/agent-core-v2": "workspace:^",
    "@moonshot-ai/kimi-code-oauth": "workspace:^"
  }
}
