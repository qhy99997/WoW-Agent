{
  "name": "@moonshot-ai/kimi-code-oauth",
  "version": "0.4.0",
  "private": true,
  "description": "Kimi OAuth toolkit for managed Kimi Code authentication",
  "license": "MIT",
  "author": "WoW",
  "homepage": "https://github.com/qhy99997/WoW-Agent/tree/main/packages/oauth#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qhy99997/WoW-Agent.git",
    "directory": "packages/oauth"
  },
  "bugs": {
    "url": "https://github.com/qhy99997/WoW-Agent/issues"
  },
  "keywords": [
    "kimi",
    "oauth",
    "authentication",
    "auth",
    "cli"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./device": {
      "types": "./src/device.ts",
      "default": "./src/device.ts"
    },
    "./provider-credential": {
      "types": "./src/provider-credential.ts",
      "default": "./src/provider-credential.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4"
  }
}
