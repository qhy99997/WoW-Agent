{
  "name": "@wow/desktop",
  "productName": "WoW",
  "version": "0.1.0",
  "private": true,
  "description": "WoW desktop agent",
  "author": "WoW",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win --x64",
    "clean": "node -e \"require('node:fs').rmSync('out',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@moonshot-ai/kimi-code-sdk": "workspace:^",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.15.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "vite": "8.3.5",
    "zod": "catalog:"
  }
}
