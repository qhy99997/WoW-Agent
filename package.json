{
  "name": "wow-agent",
  "version": "0.1.0",
  "private": true,
  "description": "WoW Agent — a local-first AI workbench for Windows. Kimi-style agent harness, Vetta-style workspace.",
  "author": "WoW Agent",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview:web": "vite --config vite.preview.config.ts",
    "package": "npm run build && electron-builder --win",
    "package:dir": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "ansi-to-html": "^0.7.2",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.1.0",
    "@types/diff": "^8.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
