{
  "name": "wow-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "build:packages": "pnpm -r --filter \"./packages/*\" run build",
    "dev": "pnpm -C apps/desktop run dev",
    "dev:packages": "pnpm -r --parallel --filter \"./packages/*\" run dev",
    "typecheck": "pnpm run build:packages && pnpm -r --filter \"./packages/*\" run typecheck && pnpm --filter @wow/desktop run typecheck",
    "lint": "node scripts/check-no-comments.mjs && oxlint --type-aware",
    "lint:fix": "pnpm run lint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "pnpm -r run clean",
    "dist": "pnpm run build && pnpm --filter @wow/desktop run dist"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "4.1.4",
    "oxlint": "1.59.0",
    "oxlint-tsgolint": "0.20.0",
    "tsdown": "0.22.0",
    "tsx": "^4.21.0",
    "typescript": "6.0.2",
    "vitest": "4.1.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix --quiet",
      "oxlint --type-aware --quiet"
    ]
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@10.33.0"
}
